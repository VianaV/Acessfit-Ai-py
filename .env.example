# .env.example
# -----------------------------------------------------------
# Arquivo de exemplo para configuração do ambiente.
#
# Como usar:
#   1. Copie este arquivo para um novo arquivo chamado .env
#      cp .env.example .env
#
#   2. Substitua os valores de exemplo pelos valores reais.
#
#   3. NUNCA commite o arquivo .env no Git!
#      Ele já está no .gitignore por padrão.
# -----------------------------------------------------------

# Ambiente da aplicação: development | staging | production
APP_ENV=

# Chave de API da OpenAI
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Exemplos: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=
